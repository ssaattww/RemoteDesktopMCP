# Local-development URL. This MVP listens only on 127.0.0.1 and does not
# enable Funnel or any public deployment.
BASE_URL=http://127.0.0.1:3000
PORT=3000

# Generate a 32-byte random base64url value, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_SECRET=replace-with-a-long-random-secret

# Exactly one local-development account may grant access. Generate its hash
# with: npm run user:hash -- 'a-long-unique-password'
AUTHORIZED_USERS_JSON=[{"email":"admin@example.com","passwordHash":"scrypt$REPLACE_ME"}]

# Folders exposed to file and transfer tools. DATA_DIR and Desktop Commander
# configuration must not overlap any listed root.
FILE_ROOTS_JSON=[{"id":"documents","path":"C:\\\\Users\\\\operator\\\\Documents"}]

# Service state, audit log, immutable transfer snapshots, and the isolated
# Desktop Commander child home. Keep this outside FILE_ROOTS_JSON.
DATA_DIR=data
LOCAL_NODE_ID=local
LOCAL_NODE_LABEL=This PC
TRANSFER_CHUNK_BYTES=131072

# Comma-separated origins permitted at registration. Each authorization uses
# an exact URI from the client's registered list and PKCE S256.
ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
