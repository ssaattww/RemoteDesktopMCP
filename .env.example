# This must be the public HTTPS URL that ChatGPT can reach. Do not use localhost.
BASE_URL=https://mcp.example.com
PORT=3000

# Generate a 32-byte random base64url value, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_SECRET=replace-with-a-long-random-secret

# A JSON list of accounts allowed to grant ChatGPT access. Generate each
# password hash with: npm run user:hash -- 'a-long-unique-password'
AUTHORIZED_USERS_JSON=[{"email":"admin@example.com","passwordHash":"scrypt$REPLACE_ME"}]

# A JSON list of fixed launch presets. No user-provided executable or arguments
# are ever accepted. Use absolute command and cwd paths.
LAUNCH_PRESETS_JSON=[{"id":"open-notepad","label":"Open Notepad","command":"C:\\\\Windows\\\\System32\\\\notepad.exe","args":[],"cwd":"C:\\\\"}]

# A JSON list of folders that search and download tools may access. All symlinks
# are skipped, and paths outside these roots are rejected.
FILE_ROOTS_JSON=[{"id":"documents","path":"C:\\\\Users\\\\operator\\\\Documents"}]

# Comma-separated exact origins permitted to make browser OAuth requests.
ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
