# Local-development URL. This MVP listens only on 127.0.0.1 and does not
# enable Funnel or any public deployment.
BASE_URL=http://127.0.0.1:3000
PORT=3000

# `password` is limited to loopback development. For a public HTTPS deployment,
# use `google`, create this file through `npm run remote-auth -- configure`, and
# then approve the single Google subject through `authorize-google`.
REMOTE_AUTH_MODE=password

# Generate a 32-byte random base64url value, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_SECRET=replace-with-a-long-random-secret

# Exactly one local-development account may grant access. Generate its hash
# with: npm run user:hash -- 'a-long-unique-password'
AUTHORIZED_USERS_JSON=[{"email":"admin@example.com","passwordHash":"scrypt$REPLACE_ME"}]

# File and transfer tools accept absolute paths that the service OS user can
# access. RemoteDesktopMCP reserves DATA_DIR and its protected service files
# from those APIs.
DATA_DIR=data
LOCAL_NODE_ID=local
LOCAL_NODE_LABEL=This PC
TRANSFER_CHUNK_BYTES=131072

# Comma-separated origins permitted at registration. Each authorization uses
# an exact URI from the client's registered list and PKCE S256.
ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com

# Public Google mode only. The configured public callback must be exactly
# `${BASE_URL}/google/callback`; the administrator-only callback is fixed at
# http://localhost:8765/callback. Do not put real values in this example.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_LOCAL_REDIRECT_URI=http://localhost:8765/callback
